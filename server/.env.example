# GVI backend configuration. Copy to `.env` and fill in to go live.
# With NO keys set, the system runs fully in mock mode (synthetic but real pipeline).

# --- Reasoning (provider-agnostic) ---
# Add a key to switch the agents from mock reasoning to genuine LLM reasoning.
# Provider auto-selects: Anthropic if its key is set, else OpenAI-compatible if
# an OpenAI key or base_url is set, else mock. Force it with LLM_PROVIDER.
# LLM_PROVIDER=anthropic   # anthropic | openai | mock

# Option A — Anthropic. Defaults model to claude-opus-5-5; for a chatty loop
# claude-haiku-5-5 is far cheaper and usually plenty:
ANTHROPIC_API_KEY=
# GVI_MODEL=claude-haiku-5-5

# Option B — any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together,
# Groq, or a local Ollama/vLLM/LM Studio server). Set the base_url to point it
# anywhere; the key is optional for local servers. Model defaults to gpt-4o-mini.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # e.g. http://localhost:11434/v1 for Ollama
# OPENAI_MODEL=gpt-4o-mini                     # or GVI_MODEL to override either provider

# --- Web discovery (pluggable search tool) ---
# Add a Tavily key (free tier at tavily.com) for real web discovery.
TAVILY_API_KEY=

# --- Remote alerts (Telegram) ---
# 1. Message @BotFather on Telegram, /newbot, copy the token below.
# 2. Message your new bot once, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning ---
# PORT=8787
# GVI_TEMPO=2200   # ms between hunter beats; lower = faster
